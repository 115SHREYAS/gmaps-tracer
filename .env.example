# --- Database ---
DATABASE_URL=postgres://gps:gps@localhost:5432/gpstracer

# --- Auth (SESSION_SECRET must be >= 32 chars; generate: openssl rand -hex 32) ---
APP_PASSWORD=changeme
SESSION_SECRET=please-change-me-to-a-long-random-64-hex-string!!

# --- Poller ---
POLL_INTERVAL_SECONDS=300

# Index of the Google account to query when several accounts are signed into
# the same browser (0 = first/default account, 1 = second, ...). Check which
# ?authuser=N appears in the URL of the account whose shares you want.
GOOGLE_AUTHUSER=0

# Optional: track the authenticated Google account itself
GOOGLE_EMAIL=

# --- Notifications & Alerts ---
# Telegram Bot: create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: channel settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# ntfy: topic name (https://ntfy.sh/<topic>) or full custom server URL
NTFY_TOPIC=
NTFY_URL=

# Generic HTTP Webhook (POST JSON)
GENERIC_WEBHOOK_URL=

# Low battery alert percentage threshold (default: 20)
BATTERY_ALERT_THRESHOLD=20

# --- HTTP Location Ingestion (OwnTracks & Webhooks) ---
# Optional secret token required to send locations via /api/ingest/owntracks or /api/ingest/generic
INGEST_TOKEN=

# --- Map ---
# pmtiles = self-hosted offline tiles at /tiles/bangalore.pmtiles (falls back to OSM if missing)
# osm     = online OpenStreetMap raster tiles (dev fallback)
NEXT_PUBLIC_MAP_STYLE=pmtiles
NEXT_PUBLIC_MAP_CENTER_LAT=12.9716
NEXT_PUBLIC_MAP_CENTER_LNG=77.5946
NEXT_PUBLIC_MAP_ZOOM=11

# Timezone used for date/time filters (IST)
TZ_OFFSET=+05:30

# Where the tiles route handler looks for .pmtiles files (server-side)
TILES_PATH=./tiles

# --- Production (docker compose) ---
DOMAIN=maps.example.com
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=gps
POSTGRES_USER=gps
POSTGRES_DB=gpstracer
