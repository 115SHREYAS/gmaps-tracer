# --- Database ---
DATABASE_URL=postgres://gps:gps@localhost:5432/gpstracer

# --- Auth (SESSION_SECRET must be >= 32 chars; generate: openssl rand -hex 32) ---
APP_PASSWORD=changeme
SESSION_SECRET=please-change-me-to-a-long-random-64-hex-string!!

# --- Poller ---
POLL_INTERVAL_SECONDS=300

# Optional: track the authenticated Google account itself
GOOGLE_EMAIL=

# --- Map ---
# pmtiles = self-hosted offline tiles at /tiles/bangalore.pmtiles (falls back to OSM if missing)
# osm     = online OpenStreetMap raster tiles (dev fallback)
NEXT_PUBLIC_MAP_STYLE=pmtiles
NEXT_PUBLIC_MAP_CENTER_LAT=12.9716
NEXT_PUBLIC_MAP_CENTER_LNG=77.5946
NEXT_PUBLIC_MAP_ZOOM=11

# Timezone used for date/time filters (IST)
TZ_OFFSET=+05:30

# Where the tiles route handler looks for .pmtiles files (server-side)
TILES_PATH=./tiles

# --- Production (docker compose) ---
DOMAIN=maps.example.com
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=gps
POSTGRES_USER=gps
POSTGRES_DB=gpstracer
