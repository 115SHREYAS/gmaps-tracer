# --- dependencies / builds ---
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# --- secrets: environment files (example stays tracked) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- secrets: Google session cookies in any form ---
