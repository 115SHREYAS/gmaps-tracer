cookies.txt
*.cookies
*.har

# --- local data (tiles are 100MB+, backups contain full location history) ---
tiles/*.pmtiles
backups/

# --- logs / OS junk ---
*.log
.DS_Store
Thumbs.db

# --- private planning notes ---
session-*.md

# --- local-only docs / explainers ---
local-explainers/
